{
    "name": "indianopinion/sigv4-php",
    "description": "AWS Signature Version 4 signing, presigned URLs and an instance-role credential chain for PHP, with no runtime dependencies.",
    "type": "library",
    "license": "MIT",
    "keywords": ["aws", "sigv4", "signature", "presign", "imds", "imdsv2", "s3", "credentials"],
    "homepage": "https://github.com/IndianOpinion/sigv4-php",
    "support": {
        "issues": "https://github.com/IndianOpinion/sigv4-php/issues",
        "source": "https://github.com/IndianOpinion/sigv4-php",
        "security": "https://github.com/IndianOpinion/sigv4-php/blob/main/SECURITY.md"
    },
    "authors": [
        {
            "name": "Indian Opinion",
            "email": "hello@indianopinion.org"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "psr/http-message": "^1.1 || ^2.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "suggest": {
        "ext-curl": "Preferred HTTP transport for credential fetches (PHP streams are used otherwise)",
        "ext-sodium": "Required for the encrypted shared credential cache",
        "ext-apcu": "Enables the APCu credential cache adapter"
    },
    "autoload": {
        "psr-4": {
            "IndianOpinion\\SigV4\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IndianOpinion\\SigV4\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "cs": "phpcs",
        "cs-fix": "phpcbf",
        "check": ["@cs", "@analyse", "@test"]
    }
}
